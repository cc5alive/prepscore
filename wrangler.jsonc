{
  "name": "prepscore",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Serve only on prepscore.org (custom domains set in the dashboard).
  // Without these, every deploy re-enables the public workers.dev and preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Anonymous retailer-click counter (see worker.js). Query it in the dashboard: D1 > prepscore-clicks > Console.
  "d1_databases": [
    { "binding": "CLICKS", "database_name": "prepscore-clicks", "database_id": "bc48b476-f4e1-4118-a2f7-3a2db9e8cc27" }
  ],
  // IndexNow: once a day the Worker tells Bing (and through it, other engines) which pages changed.
  // The key is public by design; build.py publishes it as /<key>.txt to prove we own the site.
  "vars": { "INDEXNOW_KEY": "bce8728ec33f008ab50a6ff9824cc06c" },
  "triggers": { "crons": ["17 15 * * *"] },
  "observability": { "enabled": true }
}
